<script type="module">
  import emailjs from "https://cdn.jsdelivr.net/npm/@emailjs/browser@4/+esm";

  emailjs.init("Wnmz_tauG1p-dtmaF");

  const form = document.getElementById("contactForm");
  const btn = document.getElementById("btnEnviar");
  const msgEl = document.getElementById("formMensaje");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    // Validar campos requeridos
    const nombre = form.nombre.value.trim();
    const email = form.email.value.trim();
    if (!nombre || !email) return;

    // Estado cargando
    btn.disabled = true;
    btn.textContent = "Enviando...";
    msgEl.style.display = "none";

    const params = {
      nombre:     nombre,
      empresa:    form.empresa.value.trim() || "—",
      from_email: email,
      email:      email,
      interes:    form.interes.value || "No especificado",
      mensaje:    form.mensaje.value.trim() || "—",
    };

    try {
      await emailjs.send("service_raul4q", "template_rd29wef", params);

      // Éxito
      msgEl.style.display = "block";
      msgEl.style.background = "#f0fdf4";
      msgEl.style.border = "1px solid #bbf7d0";
      msgEl.style.color = "#16a34a";
      msgEl.textContent = "✓ Mensaje enviado. Nos pondremos en contacto a la brevedad.";
      form.reset();
    } catch (err) {
      console.error(err);
      msgEl.style.display = "block";
      msgEl.style.background = "#fef2f2";
      msgEl.style.border = "1px solid #fecaca";
      msgEl.style.color = "#dc2626";
      msgEl.textContent = "Error al enviar. Por favor intente nuevamente o escríbanos directamente.";
    } finally {
      btn.disabled = false;
      btn.textContent = "Enviar mensaje";
    }
  });
</script>

<script>
