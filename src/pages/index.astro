    appId: "1:436737051330:web:b62a9f69e9fe5dc968895b",
  };

  const app = getApps().length === 0 ? initializeApp(firebaseConfig) : getApps()[0];
  const db = getFirestore(app, "default");

  // ── Helpers ─────────────────────────────────────────────────────────────────
  function svgPlaceholder(id, tag) {
    return `<svg viewBox="0 0 400 220" xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%;display:block;">
      <defs><linearGradient id="g${id}" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" style="stop-color:#3b1d6e;stop-opacity:1"/>
        <stop offset="100%" style="stop-color:#0e0e12;stop-opacity:1"/>
      </linearGradient></defs>
      <rect width="400" height="220" fill="url(#g${id})"/>
      <rect x="130" y="70" width="55" height="130" fill="#7b45c4" opacity="0.25" rx="2"/>
      <rect x="195" y="50" width="50" height="150" fill="#9b72cf" opacity="0.25" rx="2"/>
      <rect x="95" y="90" width="42" height="110" fill="#3b1d6e" opacity="0.45" rx="2"/>
      <path d="M 20 140 Q 200 100 380 140" fill="none" stroke="#7b45c4" stroke-width="1" opacity="0.4"/>
      <circle cx="200" cy="110" r="28" fill="none" stroke="#c9a8f0" stroke-width="0.7" opacity="0.3"/>
      <text x="200" y="192" text-anchor="middle" font-family="serif" font-size="11" fill="#c9a8f0" opacity="0.6">${tag || ""}</text>
    </svg>`;
  }

  // ── Card HTML ────────────────────────────────────────────────────────────────
  function crearCardHTML(p) {
    const tipoLabel = p.tipo === "venta" ? "Venta" : "Arriendo";
    const precioLabel = `UF ${Number(p.precio).toLocaleString("es-CL")}${p.tipo === "arriendo" ? " /mes" : ""}`;
    const imagenHTML = p.imagenes && p.imagenes.length > 0
      ? `<img src="${p.imagenes[0]}" alt="${p.nombre}" loading="lazy" />`
      : svgPlaceholder(p.id, p.tag);

    const chips = [];
    if (p.m2) chips.push(`${p.m2} m²`);
    if (p.dormitorios) chips.push(`${p.dormitorios} dorm.`);
    if (p.banos) chips.push(`${p.banos} baños`);

    const chipsHTML = chips.map(c => `<span class="chip">${c}</span>`).join("");

    return `
      <article class="propiedad-card" data-tipo="${p.tipo}" data-id="${p.id}">
        <div class="propiedad-card__imagen">
          ${imagenHTML}
          <span class="badge badge--${p.tipo}">${tipoLabel}</span>
          <div class="propiedad-card__ver"><span>Ver detalle →</span></div>
        </div>
        <div class="propiedad-card__body">
          <p class="propiedad-card__tag">${p.tag || ""}</p>
          <h3 class="propiedad-card__nombre">${p.nombre}</h3>
          <p class="propiedad-card__ubicacion">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
            </svg>
            ${p.comuna ? p.comuna + ", Santiago" : p.ubicacion || ""}
          </p>
          <p class="propiedad-card__desc">${p.descripcion || ""}</p>
          <div class="propiedad-card__footer">
            <div>
              <span class="propiedad-card__precio">${precioLabel}</span>
              ${chips.length ? `<div class="propiedad-card__chips">${chipsHTML}</div>` : ""}
            </div>
          </div>
        </div>
      </article>`;
  }

  // ── Modal ────────────────────────────────────────────────────────────────────
  let propiedadesData = [];
  let modalImagenActual = 0;

  function abrirModal(p) {
    const modal = document.getElementById("propModal");
    const imagenes = p.imagenes && p.imagenes.length > 0 ? p.imagenes : [];
    modalImagenActual = 0;

    // Galería
    const galeriaEl = document.getElementById("modalGaleria");
    if (imagenes.length > 0) {
      galeriaEl.innerHTML = `
        <img id="modalImgPrincipal" src="${imagenes[0]}" alt="${p.nombre}" style="width:100%;height:100%;object-fit:cover;display:block;" />
        ${imagenes.length > 1 ? `
          <button class="modal__galeria-nav modal__galeria-nav--prev" id="galPrev">&#8249;</button>
          <button class="modal__galeria-nav modal__galeria-nav--next" id="galNext">&#8250;</button>
          <span class="modal__galeria-counter" id="galCounter">1 / ${imagenes.length}</span>
        ` : ""}`;

      // Miniaturas
      if (imagenes.length > 1) {
        const thumbsDiv = document.createElement("div");
        thumbsDiv.className = "modal__thumbs";
        thumbsDiv.id = "modalThumbs";
        imagenes.forEach((url, i) => {
          const img = document.createElement("img");
          img.src = url;
          img.alt = "";
          if (i === 0) img.classList.add("active");
          img.addEventListener("click", () => cambiarImagen(imagenes, i));
          thumbsDiv.appendChild(img);
        });
        galeriaEl.after(thumbsDiv);

        document.getElementById("galPrev")?.addEventListener("click", () =>
          cambiarImagen(imagenes, (modalImagenActual - 1 + imagenes.length) % imagenes.length));
        document.getElementById("galNext")?.addEventListener("click", () =>
          cambiarImagen(imagenes, (modalImagenActual + 1) % imagenes.length));
      }
    } else {
      galeriaEl.innerHTML = svgPlaceholder(p.id + "_modal", p.tag);
      // Quitar thumbs si existían
      document.getElementById("modalThumbs")?.remove();
    }

    // Datos
    document.getElementById("modalTag").textContent = p.tag || "";
    const badgeEl = document.getElementById("modalBadge");
    badgeEl.textContent = p.tipo === "venta" ? "Venta" : "Arriendo";
    badgeEl.className = `modal__badge ${p.tipo}`;
    document.getElementById("modalTitulo").textContent = p.nombre;
    document.getElementById("modalUbicacion").innerHTML = `
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
      </svg>
      ${p.ubicacion || (p.comuna ? p.comuna + ", Santiago" : "")}`;

    // Stats
    const precio = `UF ${Number(p.precio).toLocaleString("es-CL")}${p.tipo === "arriendo" ? " /mes" : ""}`;
    const statsItems = [
      { val: precio, lbl: p.tipo === "arriendo" ? "Precio arriendo" : "Precio venta" },
      { val: `${p.m2} m²`, lbl: "Superficie" },
    ];
    if (p.dormitorios) statsItems.push({ val: p.dormitorios, lbl: "Dormitorios" });
    else if (p.banos) statsItems.push({ val: p.banos, lbl: "Baños" });

    document.getElementById("modalStats").innerHTML = statsItems.map(s =>
      `<div class="modal__stat"><span class="modal__stat-val">${s.val}</span><span class="modal__stat-lbl">${s.lbl}</span></div>`
    ).join("");

    document.getElementById("modalDesc").textContent = p.descripcion || "";

    // Abrir
    modal.classList.add("open");
    modal.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
  }

  function cambiarImagen(imagenes, idx) {
    modalImagenActual = idx;
    const img = document.getElementById("modalImgPrincipal");
    const counter = document.getElementById("galCounter");
    const thumbs = document.querySelectorAll("#modalThumbs img");
    if (img) img.src = imagenes[idx];
    if (counter) counter.textContent = `${idx + 1} / ${imagenes.length}`;
    thumbs.forEach((t, i) => t.classList.toggle("active", i === idx));
  }

  function cerrarModal() {
    const modal = document.getElementById("propModal");
    modal.classList.remove("open");
    modal.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
    // Limpiar thumbs
    document.getElementById("modalThumbs")?.remove();
  }

  // ── Filtros ──────────────────────────────────────────────────────────────────
  function activarFiltros() {
    document.querySelectorAll(".filtro").forEach(btn => {
      btn.addEventListener("click", () => {
        document.querySelectorAll(".filtro").forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
        const filter = btn.dataset.filter;
        document.querySelectorAll(".propiedad-card").forEach(card => {
          card.style.display = (filter === "todos" || card.dataset.tipo === filter) ? "" : "none";
        });
      });
    });
  }

  // ── Cargar propiedades ───────────────────────────────────────────────────────
  async function cargarPropiedades() {
    const grid = document.getElementById("propiedadesGrid");
    if (!grid) return;
    try {
      const q = query(collection(db, "propiedades"), where("estado", "==", "disponible"));
      const snapshot = await getDocs(q);

      if (snapshot.empty) {
        grid.innerHTML = `<div style="grid-column:1/-1;text-align:center;padding:3rem;color:#888;"><p>No hay propiedades disponibles en este momento.</p></div>`;
        return;
      }

      propiedadesData = snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }));
      grid.innerHTML = propiedadesData.map(crearCardHTML).join("");

      // Click en cards
      grid.querySelectorAll(".propiedad-card").forEach(card => {
        card.addEventListener("click", () => {
          const p = propiedadesData.find(x => x.id === card.dataset.id);
          if (p) abrirModal(p);
        });
      });

      activarFiltros();
    } catch (err) {
      console.error("Error al cargar propiedades:", err);
      grid.innerHTML = `<div style="grid-column:1/-1;text-align:center;padding:3rem;color:#888;"><p>Error al cargar propiedades.</p></div>`;
    }
  }

  // ── Eventos modal ────────────────────────────────────────────────────────────
  document.getElementById("modalClose")?.addEventListener("click", cerrarModal);
  document.getElementById("modalBackdrop")?.addEventListener("click", cerrarModal);
  document.getElementById("modalCTA")?.addEventListener("click", cerrarModal);
  document.addEventListener("keydown", e => { if (e.key === "Escape") cerrarModal(); });

  cargarPropiedades();
</script>
