---
import Layout from "../layouts/Layout.astro";
import Logo from "../components/Logo.astro";

const firebaseConfig = {
  apiKey: import.meta.env.PUBLIC_FIREBASE_API_KEY,
  authDomain: import.meta.env.PUBLIC_FIREBASE_AUTH_DOMAIN,
  projectId: import.meta.env.PUBLIC_FIREBASE_PROJECT_ID,
  storageBucket: import.meta.env.PUBLIC_FIREBASE_STORAGE_BUCKET,
  messagingSenderId: import.meta.env.PUBLIC_FIREBASE_MESSAGING_SENDER_ID,
  appId: import.meta.env.PUBLIC_FIREBASE_APP_ID,
};
---

<Layout>
  <!-- ═══════════════════════════════════ NAV ═══════════════════════════════════ -->
  <header class="nav">
    <div class="nav__inner">
      <a href="/" aria-label="Inicio">
        <Logo variant="light" size={44} />
      </a>
      <nav class="nav__links">
        <a href="#nosotros">Nosotros</a>
        <a href="#propiedades">Propiedades</a>
        <a href="#servicios">Servicios</a>
        <a href="#contacto">Contacto</a>
        <a href="https://purpura-portal.vercel.app" class="nav__portal">Portal Institucional</a>
      </nav>
      <button class="nav__hamburger" id="menuBtn" aria-label="Abrir menú">
        <span></span><span></span><span></span>
      </button>
    </div>
    <div class="nav__mobile" id="mobileMenu">
      <a href="#nosotros">Nosotros</a>
      <a href="#propiedades">Propiedades</a>
      <a href="#servicios">Servicios</a>
      <a href="#contacto">Contacto</a>
      <a href="https://purpura-portal.vercel.app" class="nav__portal">Portal Institucional</a>
    </div>
  </header>

  <!-- ═══════════════════════════════════ HERO ═══════════════════════════════════ -->
  <section class="hero">
    <div class="hero__bg"></div>
    <div class="hero__content">
      <p class="hero__eyebrow">Inversiones Inmobiliarias · Chile</p>
      <h1 class="hero__titulo">
        Desarrollamos el futuro<br />del mercado inmobiliario
      </h1>
      <p class="hero__subtitulo">
        Más de 12 años planificando, gestionando y desarrollando proyectos<br />
        de alto valor para instituciones e inversores en Chile.
      </p>
      <div class="hero__ctas">
        <a href="#propiedades" class="btn btn--primary">Ver propiedades</a>
        <a href="#contacto" class="btn btn--outline">Contáctenos</a>
      </div>
    </div>
    <div class="hero__deco">
      <svg viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
        <path d="M 20 200 Q 200 20 380 200" fill="none" stroke="#7b45c4" stroke-width="1.5" opacity="0.4"/>
        <path d="M 20 200 Q 200 380 380 200" fill="none" stroke="#9b72cf" stroke-width="1.5" opacity="0.4"/>
        <circle cx="200" cy="200" r="60" fill="none" stroke="#c9a8f0" stroke-width="1" opacity="0.3"/>
        <circle cx="200" cy="200" r="120" fill="none" stroke="#7b45c4" stroke-width="0.8" opacity="0.2"/>
        <circle cx="200" cy="200" r="180" fill="none" stroke="#3b1d6e" stroke-width="0.5" opacity="0.15"/>
        <circle cx="200" cy="200" r="10" fill="#7b45c4" opacity="0.6"/>
        <circle cx="200" cy="200" r="4" fill="#c9a8f0" opacity="0.9"/>
      </svg>
    </div>
    <div class="hero__stats">
      <div class="stat">
        <span class="stat__num">+12</span>
        <span class="stat__label">Años de experiencia</span>
      </div>
      <div class="stat__divider"></div>
      <div class="stat">
        <span class="stat__num">+80</span>
        <span class="stat__label">Proyectos gestionados</span>
      </div>
      <div class="stat__divider"></div>
      <div class="stat">
        <span class="stat__num">6</span>
        <span class="stat__label">Instituciones activas</span>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════ NOSOTROS ════════════════════════════════ -->
  <section class="nosotros" id="nosotros">
    <div class="container">
      <div class="nosotros__grid">
        <div class="nosotros__visual">
          <div class="nosotros__visual-inner">
            <svg viewBox="0 0 300 300" xmlns="http://www.w3.org/2000/svg">
              <rect width="300" height="300" fill="var(--color-fondo-claro)" rx="4"/>
              <path d="M 30 150 Q 150 30 270 150" fill="none" stroke="var(--color-purpura-oscuro)" stroke-width="3"/>
              <path d="M 30 150 Q 150 270 270 150" fill="none" stroke="var(--color-purpura-medio)" stroke-width="3"/>
              <circle cx="150" cy="150" r="20" fill="var(--color-fondo-claro)" stroke="var(--color-purpura-claro)" stroke-width="2"/>
              <circle cx="150" cy="150" r="8" fill="var(--color-purpura-medio)"/>
              <rect x="60" y="180" width="30" height="90" fill="var(--color-purpura-oscuro)" opacity="0.15" rx="2"/>
              <rect x="100" y="160" width="25" height="110" fill="var(--color-purpura-medio)" opacity="0.15" rx="2"/>
              <rect x="175" y="170" width="28" height="100" fill="var(--color-purpura-oscuro)" opacity="0.15" rx="2"/>
              <rect x="213" y="150" width="22" height="120" fill="var(--color-purpura-medio)" opacity="0.15" rx="2"/>
              <line x1="40" y1="270" x2="260" y2="270" stroke="var(--color-lila)" stroke-width="1" opacity="0.5"/>
            </svg>
          </div>
          <div class="nosotros__badge">
            <span class="nosotros__badge-num">12+</span>
            <span class="nosotros__badge-text">años en el<br/>mercado</span>
          </div>
        </div>

        <div class="nosotros__texto">
          <p class="section__eyebrow">Quiénes somos</p>
          <h2 class="section__titulo">Una empresa con visión de largo plazo</h2>
          <p class="nosotros__parrafo">
            Grupo Púrpura es una empresa chilena especializada en la planificación, gestión y desarrollo de proyectos inmobiliarios. Desde nuestra oficina en Vitacura, operamos en los principales mercados del país, conectando oportunidades de inversión con instituciones de primer nivel.
          </p>
          <p class="nosotros__parrafo">
            Nuestra propuesta de valor se basa en la transparencia, el rigor técnico y una relación de largo plazo con cada cliente. No gestionamos volumen: gestionamos valor.
          </p>
          <div class="nosotros__pilares">
            <div class="pilar">
              <div class="pilar__icono">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M3 21h18M3 10h18M3 7l9-4 9 4M4 10v11M20 10v11M8 10v11M12 10v11M16 10v11"/>
                </svg>
              </div>
              <div>
                <strong>Desarrollo</strong>
                <p>Gestión integral de proyectos desde la concepción hasta la entrega.</p>
              </div>
            </div>
            <div class="pilar">
              <div class="pilar__icono">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/>
                </svg>
              </div>
              <div>
                <strong>Experiencia</strong>
                <p>Más de una década operando en los mercados más competitivos del país.</p>
              </div>
            </div>
            <div class="pilar">
              <div class="pilar__icono">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
              </div>
              <div>
                <strong>Confianza</strong>
                <p>Relaciones de largo plazo con instituciones líderes del sector.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════ PROPIEDADES ══════════════════════════════ -->
  <section class="propiedades" id="propiedades">
    <div class="container">
      <div class="section__header">
        <p class="section__eyebrow">Portafolio</p>
        <h2 class="section__titulo">Propiedades disponibles</h2>
        <p class="section__desc">Selección actual de activos en arriendo y venta. Para fichas completas, acceda al portal institucional.</p>
      </div>
      <div class="filtros">
        <button class="filtro active" data-filter="todos">Todos</button>
        <button class="filtro" data-filter="venta">En venta</button>
        <button class="filtro" data-filter="arriendo">En arriendo</button>
      </div>

      <!-- Grid de propiedades: se llena dinámicamente desde Firestore -->
      <div class="propiedades__grid" id="propiedadesGrid">
        <!-- Skeletons mientras carga -->
        <div class="propiedad-skeleton"></div>
        <div class="propiedad-skeleton"></div>
        <div class="propiedad-skeleton"></div>
      </div>

      <div class="propiedades__cta">
        <p>¿Es usted una institución? Acceda a fichas técnicas completas en nuestro portal privado.</p>
        <a href="https://purpura-portal.vercel.app" class="btn btn--primary">Acceder al portal →</a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════ MODAL DETALLE ══════════════════════════════ -->
  <div id="propModal" class="modal" role="dialog" aria-modal="true" aria-hidden="true">
    <div class="modal__backdrop" id="modalBackdrop"></div>
    <div class="modal__panel">
      <button class="modal__close" id="modalClose" aria-label="Cerrar">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>

      <!-- Galería -->
      <div class="modal__galeria" id="modalGaleria"></div>

      <!-- Contenido -->
      <div class="modal__body">
        <div class="modal__header">
          <span class="modal__tag" id="modalTag"></span>
          <span class="modal__badge" id="modalBadge"></span>
        </div>
        <h2 class="modal__titulo" id="modalTitulo"></h2>
        <p class="modal__ubicacion" id="modalUbicacion"></p>

        <div class="modal__stats" id="modalStats"></div>

        <p class="modal__desc" id="modalDesc"></p>

        <a href="#contacto" class="btn btn--primary btn--full" id="modalCTA">Consultar esta propiedad</a>
      </div>
    </div>
  </div>

  <!-- ════════════════════════════════ SERVICIOS ════════════════════════════════ -->
  <section class="servicios" id="servicios">
    <div class="container">
      <div class="section__header section__header--light">
        <p class="section__eyebrow section__eyebrow--light">Lo que hacemos</p>
        <h2 class="section__titulo section__titulo--light">Nuestros servicios</h2>
      </div>
      <div class="servicios__grid">
        <div class="servicio-item">
          <div class="servicio-item__num">01</div>
          <h3>Desarrollo de proyectos</h3>
          <p>Gestión completa desde la búsqueda del terreno hasta la entrega final: permisos, construcción, comercialización.</p>
        </div>
        <div class="servicio-item">
          <div class="servicio-item__num">02</div>
          <h3>Gestión de activos</h3>
          <p>Administración estratégica de portafolios inmobiliarios para instituciones que buscan rentabilidad sostenida.</p>
        </div>
        <div class="servicio-item">
          <div class="servicio-item__num">03</div>
          <h3>Intermediación y venta</h3>
          <p>Asesoría especializada para la compraventa de activos inmobiliarios de alta complejidad y gran envergadura.</p>
        </div>
        <div class="servicio-item">
          <div class="servicio-item__num">04</div>
          <h3>Arriendo corporativo</h3>
          <p>Búsqueda y gestión de espacios para empresas e instituciones con requerimientos específicos de ubicación y superficie.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════ CONTACTO ══════════════════════════════════ -->
  <section class="contacto" id="contacto">
    <div class="container">
      <div class="contacto__grid">
        <div class="contacto__info">
          <p class="section__eyebrow">Hablemos</p>
          <h2 class="section__titulo">¿Tiene algún proyecto en mente?</h2>
          <p class="contacto__desc">Estamos disponibles para atender a inversores, instituciones y desarrolladores que busquen un socio estratégico en el mercado inmobiliario chileno.</p>
          <div class="contacto__datos">
            <div class="dato">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
              </svg>
              <span>Av. Pdte. Kennedy 7440, of. 405<br/>Vitacura, Santiago, Chile</span>
            </div>
            <div class="dato">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.6 3.32a2 2 0 0 1 1.98-2H6.5a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 9A16 16 0 0 0 15 16.09l.82-.82a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
              <span>+56 2 2XXX XXXX</span>
            </div>
            <div class="dato">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
              </svg>
              <span>contacto@inversionespurpura.cl</span>
            </div>
          </div>
        </div>
        <form class="contacto__form" id="contactForm">
          <div class="form__row">
            <div class="form__group">
              <label for="nombre">Nombre completo</label>
              <input type="text" id="nombre" name="nombre" placeholder="Juan Pérez" required />
            </div>
            <div class="form__group">
              <label for="empresa">Empresa / Institución</label>
              <input type="text" id="empresa" name="empresa" placeholder="Empresa S.A." />
            </div>
          </div>
          <div class="form__group">
            <label for="email">Correo electrónico</label>
            <input type="email" id="email" name="email" placeholder="juan@empresa.cl" required />
          </div>
          <div class="form__group">
            <label for="interes">Tipo de interés</label>
            <select id="interes" name="interes">
              <option value="">Seleccione una opción</option>
              <option value="Compra de propiedad">Compra de propiedad</option>
              <option value="Arriendo de propiedad">Arriendo de propiedad</option>
              <option value="Desarrollo de proyecto">Desarrollo de proyecto</option>
              <option value="Gestión de activos">Gestión de activos</option>
              <option value="Otro">Otro</option>
            </select>
          </div>
          <div class="form__group">
            <label for="mensaje">Mensaje</label>
            <textarea id="mensaje" name="mensaje" rows="4" placeholder="Cuéntenos sobre su requerimiento..."></textarea>
          </div>

          <!-- Estado del envío -->
          <div id="formMensaje" style="display:none; padding:0.85rem 1.1rem; border-radius:4px; font-size:0.85rem;"></div>

          <button type="submit" class="btn btn--primary btn--full" id="btnEnviar">Enviar mensaje</button>
        </form>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════ FOOTER ═══════════════════════════════════ -->
  <footer class="footer">
    <div class="container">
      <div class="footer__grid">
        <div class="footer__brand">
          <Logo variant="light" size={40} />
          <p class="footer__tagline">Planificación, gestión y desarrollo de proyectos inmobiliarios.</p>
        </div>
        <div class="footer__nav">
          <strong>Navegación</strong>
          <a href="#nosotros">Nosotros</a>
          <a href="#propiedades">Propiedades</a>
          <a href="#servicios">Servicios</a>
          <a href="#contacto">Contacto</a>
        </div>
        <div class="footer__nav">
          <strong>Instituciones</strong>
          <a href="https://purpura-portal.vercel.app">Portal privado</a>
          <a href="#contacto">Solicitar acceso</a>
        </div>
        <div class="footer__legal-col">
          <strong>Legal</strong>
          <a href="#">Política de privacidad</a>
          <a href="#">Términos de uso</a>
        </div>
      </div>
      <div class="footer__bottom">
        <p>© {new Date().getFullYear()} Grupo Púrpura — Inversiones Púrpura SpA. Todos los derechos reservados.</p>
        <p>Av. Pdte. Kennedy 7440, of. 405, Vitacura, Santiago, Chile</p>
      </div>
    </div>
  </footer>
</Layout>

<style is:global>
  /* ─── Utilidades ─── */
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.75rem;
    font-family: var(--font-cuerpo);
    font-size: 0.8rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-radius: 3px;
    cursor: pointer;
    transition: all 0.25s ease;
    border: none;
  }
  .btn--primary { background: var(--color-purpura-medio); color: #fff; }
  .btn--primary:hover { background: var(--color-purpura-oscuro); transform: translateY(-1px); }
  .btn--outline { background: transparent; border: 1px solid rgba(255,255,255,0.5); color: #fff; }
  .btn--outline:hover { border-color: #fff; background: rgba(255,255,255,0.08); }
  .btn--sm { padding: 0.5rem 1.1rem; font-size: 0.72rem; background: var(--color-purpura-oscuro); color: #fff; }
  .btn--sm:hover { background: var(--color-purpura-medio); }
  .btn--full { width: 100%; }

  .section__eyebrow {
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-purpura-medio);
    margin-bottom: 0.75rem;
    font-weight: 400;
  }
  .section__eyebrow--light { color: var(--color-lila); }
  .section__titulo { font-size: clamp(2rem, 4vw, 3rem); color: var(--color-purpura-oscuro); margin-bottom: 1.25rem; }
  .section__titulo--light { color: #fff; }
  .section__desc { color: #666; max-width: 560px; margin: 0 auto; line-height: 1.7; }
  .section__header { text-align: center; margin-bottom: 3.5rem; }
  .section__header--light { text-align: center; margin-bottom: 3.5rem; }

  /* ─── NAV ─── */
  .nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    background: rgba(14, 14, 18, 0.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(123, 69, 196, 0.2);
  }
  .nav__inner {
    max-width: 1200px; margin: 0 auto; padding: 0 2rem;
    height: 70px; display: flex; align-items: center; justify-content: space-between;
  }
  .nav__links { display: flex; align-items: center; gap: 2rem; }
  .nav__links a {
    font-size: 0.78rem; font-weight: 300; letter-spacing: 0.08em;
    text-transform: uppercase; color: rgba(255,255,255,0.75); transition: color 0.2s;
  }
  .nav__links a:hover { color: var(--color-lila); }
  .nav__portal {
    padding: 0.45rem 1.2rem !important;
    border: 1px solid var(--color-purpura-claro) !important;
    border-radius: 3px;
    color: var(--color-lila) !important;
    transition: all 0.2s !important;
  }
  .nav__portal:hover { background: var(--color-purpura-medio) !important; color: #fff !important; border-color: transparent !important; }
  .nav__hamburger { display: none; flex-direction: column; gap: 5px; background: none; border: none; cursor: pointer; padding: 4px; }
  .nav__hamburger span { display: block; width: 22px; height: 1.5px; background: rgba(255,255,255,0.8); }
  .nav__mobile { display: none; flex-direction: column; padding: 1rem 2rem 1.5rem; gap: 1rem; border-top: 1px solid rgba(123,69,196,0.2); }
  .nav__mobile a { font-size: 0.85rem; font-weight: 300; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(255,255,255,0.75); }
  .nav__mobile.open { display: flex; }
  @media (max-width: 768px) { .nav__links { display: none; } .nav__hamburger { display: flex; } }

  /* ─── HERO ─── */
  .hero {
    min-height: 100vh; background: var(--color-fondo-oscuro);
    display: flex; flex-direction: column; justify-content: center;
    position: relative; overflow: hidden; padding-top: 70px;
  }
  .hero__bg {
    position: absolute; inset: 0;
    background: radial-gradient(ellipse at 70% 50%, rgba(59,29,110,0.5) 0%, transparent 65%),
                radial-gradient(ellipse at 20% 80%, rgba(123,69,196,0.15) 0%, transparent 50%);
  }
  .hero__content {
    position: relative; z-index: 2;
    max-width: 700px; padding: 4rem 2rem 2rem; padding-left: 8vw;
  }
  .hero__eyebrow { font-size: 0.72rem; letter-spacing: 0.25em; text-transform: uppercase; color: var(--color-lila); margin-bottom: 1.5rem; font-weight: 300; }
  .hero__titulo { font-size: clamp(2.5rem, 6vw, 4.5rem); color: #fff; line-height: 1.1; margin-bottom: 1.5rem; }
  .hero__subtitulo { font-size: 1rem; color: rgba(255,255,255,0.6); line-height: 1.75; margin-bottom: 2.5rem; font-weight: 300; }
  .hero__ctas { display: flex; gap: 1rem; flex-wrap: wrap; }
  .hero__deco {
    position: absolute; right: -2%; top: 50%; transform: translateY(-50%);
    width: min(45vw, 500px); opacity: 0.6; z-index: 1; pointer-events: none;
  }
  .hero__stats {
    position: relative; z-index: 2; display: flex; align-items: center;
    max-width: 1200px; margin: 0 auto; padding: 2rem 8vw;
    border-top: 1px solid rgba(123,69,196,0.2); margin-top: auto;
  }
  .stat { padding: 0 2.5rem; }
  .stat:first-child { padding-left: 0; }
  .stat__num { display: block; font-family: var(--font-titulo); font-size: 2.5rem; font-weight: 600; color: var(--color-lila); line-height: 1; margin-bottom: 0.3rem; }
