---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Grupo Púrpura — Inversiones Inmobiliarias",
  description = "Planificación, gestión y desarrollo de proyectos inmobiliarios. Más de 12 años de trayectoria en Chile.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=Montserrat:wght@200;300;400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --color-purpura-oscuro: #3b1d6e;
    --color-purpura-medio: #7b45c4;
    --color-purpura-claro: #9b72cf;
    --color-lila: #c9a8f0;
    --color-fondo-claro: #f4f1f9;
    --color-fondo-oscuro: #0e0e12;
    --font-titulo: "Cormorant Garamond", serif;
    --font-cuerpo: "Montserrat", sans-serif;
  }

  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: var(--font-cuerpo);
    font-weight: 300;
    color: var(--color-fondo-oscuro);
    background-color: #ffffff;
    -webkit-font-smoothing: antialiased;
  }

  h1, h2, h3, h4 {
    font-family: var(--font-titulo);
    font-weight: 600;
    line-height: 1.15;
  }

  a {
    text-decoration: none;
    color: inherit;
  }

  img {
    max-width: 100%;
    display: block;
  }
</style>
